#!/bin/sh
set -eu

repo="https://raw.githubusercontent.com/kvoon3/rex-herdr-keybinding/main"
config="${REX_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/rex/init.lua}"
dir="${REX_PLUGIN_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/rex/plugins/rex-herdr-keybinding}"
file="$dir/herdr-keybindings.lua"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

usage() {
  cat <<EOF
Usage: rex-herdr-keybinding [COMMAND]

Commands:
  install     Install the keymap and enable it (default)
  uninstall   Disable it and remove the installed files
  enable      Load the installed keymap from the config
  disable     Stop loading it, keeping the installed files
  help        Show this message

Environment:
  REX_CONFIG      Config file, default \$HOME/.config/rex/init.lua
  REX_PLUGIN_DIR  Install directory, default \$HOME/.config/rex/plugins/rex-herdr-keybinding
EOF
}

fetch() {
  mkdir -p "$dir"
  if [ -f "${0:-}" ]; then
    here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    if [ -f "$here/herdr-keybindings.lua" ]; then
      cp "$here/herdr-keybindings.lua" "$file"
      return
    fi
  fi
  curl -fsSL "$repo/herdr-keybindings.lua" -o "$file"
}

render() {
  [ -f "$config" ] || return 0
  awk '
    /rex-herdr-keybinding|herdr-keybindings\.lua/ { next }
    { line[NR] = $0 }
    END {
      last = NR
      while (last > 0 && line[last] ~ /^[[:space:]]*$/) last--
      for (i = 1; i <= last; i++) print line[i]
    }
  ' "$config"
}

save() {
  mkdir -p "$(dirname -- "$config")"
  if [ -f "$config" ] && cmp -s "$tmp/init.lua" "$config"; then
    printf 'No change to %s\n' "$config"
    return
  fi
  [ -f "$config" ] && cp "$config" "$config.bak"
  mv "$tmp/init.lua" "$config"
  printf 'Wrote %s\n' "$config"
}

enable() {
  if [ ! -f "$file" ]; then
    fetch
    printf 'Installed %s\n' "$file"
  fi
  render > "$tmp/init.lua"
  printf '\ndofile("%s")\n' "$file" >> "$tmp/init.lua"
  save
  printf 'Next: rex config check && rex config reload\n'
}

disable() {
  if [ ! -f "$config" ] || ! grep -qF -e "herdr-keybindings.lua" "$config"; then
    printf 'Already disabled in %s\n' "$config"
    return
  fi
  render > "$tmp/init.lua"
  save
  printf 'Next: rex config check && rex config reload\n'
}

case "${1:-install}" in
  install|enable)
    enable
    ;;
  uninstall)
    disable
    if [ -d "$dir" ]; then
      rm -rf "$dir"
      printf 'Removed %s\n' "$dir"
    fi
    ;;
  disable)
    disable
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac